{
  "_readme": "Single source of truth for the RoboPay design system. Edit here, then run: python3 design/build-tokens.py",
  "color": {
    "ink-950": "#05060d", "ink-900": "#0a1020", "ink-800": "#0d1528", "ink-700": "#1b2038",
    "white": "#f5f5f7",
    "text-2": "rgba(235,235,245,.66)", "text-3": "rgba(235,235,245,.5)",
    "blue-500": "#0a84ff", "blue-400": "#5ac8fa", "cyan-400": "#64d2ff",
    "violet-400": "#bf5af2", "pink-400": "#ff5ca0",
    "mint-500": "#30d158", "red-400": "#ff5d73",
    "paper": "#e9eef8", "paper-ink": "#0a1226"
  },
  "glass": {
    "bg": "rgba(255,255,255,.075)", "bg-strong": "rgba(255,255,255,.085)", "border": "rgba(255,255,255,.17)",
    "line": "rgba(255,255,255,.12)", "highlight": "rgba(255,255,255,.28)", "blur": "blur(26px) saturate(180%)"
  },
  "font": {
    "display": "\"Inter\", -apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"Helvetica Neue\", Arial, sans-serif",
    "body": "\"Inter\", -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Helvetica Neue\", Arial, sans-serif"
  },
  "weight": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700", "heavy": "800" },
  "size": {
    "_note": "Modular scale, ratio 1.25 from 1rem",
    "100": "0.8rem", "200": "1rem", "300": "1.25rem", "400": "1.5625rem", "500": "1.9531rem", "600": "2.4414rem", "700": "3.0518rem",
    "display-m": "clamp(2.1rem, 5vw, 4.3rem)", "display-l": "clamp(2.4rem, 6.4vw, 5.6rem)", "display-xl": "clamp(3.4rem, min(11.5vw, 21vh), 10.5rem)"
  },
  "leading": { "tight": "0.92", "snug": "1.02", "normal": "1.5", "relaxed": "1.6" },
  "tracking": { "display": "-0.05em", "title": "-0.03em", "body": "-0.011em" },
  "space": {
    "_note": "8pt grid with a 4px half step",
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px", "24": "96px", "32": "128px",
    "gutter": "clamp(20px, 5vw, 72px)"
  },
  "radius": { "xs": "12px", "sm": "18px", "md": "24px", "lg": "32px", "pill": "999px" },
  "shadow": {
    "glass": "inset 0 1px 0 rgba(255,255,255,.28), inset 0 -1px 0 rgba(255,255,255,.04), 0 24px 60px -28px rgba(0,0,0,.7)",
    "glow-blue": "0 14px 40px -8px rgba(10,132,255,.9)",
    "glow-cyan": "0 0 28px rgba(100,210,255,.55)"
  },
  "motion": {
    "fast": "150ms", "base": "250ms", "slow": "400ms",
    "ease-out": "cubic-bezier(.2,.8,.2,1)", "ease-spring": "cubic-bezier(.16,1,.3,1)"
  },
  "z": { "base": "0", "menu": "30", "dock": "35", "nav": "40", "progress": "50", "skip": "60" },
  "breakpoint": { "_note": "Documentation only. CSS custom properties cannot be used inside @media queries.", "sm": "560px", "md": "980px" },
  "aliases": {
    "--display": "var(--font-display)", "--body": "var(--font-body)",
    "--ink": "var(--color-ink-950)", "--deep": "var(--color-ink-900)", "--panel": "var(--color-ink-800)",
    "--text": "var(--color-white)", "--mute": "var(--color-text-2)",
    "--cyan": "var(--color-cyan-400)", "--violet": "var(--color-violet-400)", "--mint": "var(--color-mint-500)",
    "--blue": "var(--color-blue-500)", "--alarm": "var(--color-red-400)",
    "--paper": "var(--color-paper)", "--paper-ink": "var(--color-paper-ink)",
    "--line": "var(--glass-line)", "--g-bg": "var(--glass-bg)", "--g-bd": "var(--glass-border)", "--g-blur": "var(--glass-blur)",
    "--r-sm": "var(--radius-sm)", "--r-md": "var(--radius-md)", "--r-lg": "var(--radius-lg)",
    "--gut": "var(--space-gutter)", "--cut": "22px",
    "--z-nav": "var(--z-nav-i)", "--z-menu": "var(--z-menu-i)", "--z-progress": "var(--z-progress-i)"
  }
}
