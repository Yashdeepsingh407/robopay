{
  "_readme": "Single source of truth for the RoboPay design system. Edit here, then run: python3 design/build-tokens.py",
  "color": {
    "concrete": "#e6e7e4",
    "paper": "#f6f6f3",
    "ink": "#14181b",
    "ink-2": "#454c52",
    "line": "rgba(20,24,27,.2)",
    "signal": "#f5c400",
    "paid": "#0f7b4f",
    "alarm": "#c73a2b"
  },
  "font": {
    "sans": "\"Archivo\", \"Helvetica Neue\", Arial, sans-serif",
    "code": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "size": {
    "body": "1.0625rem",
    "lead": "clamp(1.15rem, 1.6vw, 1.4rem)",
    "h3": "1.35rem",
    "h2": "clamp(2.7rem, 7.4vw, 6.4rem)",
